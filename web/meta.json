{
  "title": "Customer Churn Predictor",
  "subtitle": "Predicts how likely a telecom customer is to cancel their subscription, so a retention team can contact the right people first.",
  "tags": [
    "Classification",
    "scikit-learn",
    "Logistic Regression",
    "Cross-validation",
    "ONNX"
  ],
  "task": "classification",
  "classes": [
    0,
    1
  ],
  "positive_class": 1,
  "output_label": "Probability this customer leaves",
  "verdicts": [
    "Low risk \u2014 likely to stay",
    "Medium risk \u2014 worth a check-in",
    "High risk \u2014 contact soon"
  ],
  "thresholds": [
    0.3,
    0.6
  ],
  "result_note": "Try switching Contract to \u201cTwo year\u201d or adding Tech support and watch the risk drop.",
